@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');

:root{--ink:#171714;--ivory:#f4f0e8;--paper:#fbfaf7;--brown:#6b402b;--brass:#b89a68;--muted:#77736b;--line:#ded9cf;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button,a{-webkit-tap-highlight-color:transparent}
.skip-link{position:absolute;left:-9999px;top:8px;background:white;padding:12px;z-index:99}
.skip-link:focus{left:8px}
.site-header{height:82px;padding:0 clamp(20px,6vw,88px);display:flex;align-items:center;justify-content:space-between;background:var(--paper);position:relative;z-index:20;border-bottom:1px solid rgba(23,23,20,.08)}
.brand{display:flex;align-items:center;gap:11px;min-width:0}
.brand-mark{width:43px;height:43px;object-fit:contain;mix-blend-mode:multiply}
.brand-name{font-size:13px;letter-spacing:.19em;font-weight:700;white-space:nowrap}
.brand-name span{font-weight:400;letter-spacing:.13em;margin-left:4px}
.main-nav{display:flex;align-items:center;gap:clamp(20px,3vw,42px);font-size:12px;letter-spacing:.04em}
.main-nav>a:not(.nav-cta){color:#4c4942;transition:color .2s}
.main-nav>a:hover,.text-link:hover{color:var(--brown)}
.nav-cta{border:1px solid #bcb5a8;padding:12px 16px;transition:background .2s,color .2s}
.nav-cta:hover{background:var(--ink);color:white}
.menu-toggle{display:none;background:none;border:0;padding:10px}
.menu-toggle span{display:block;width:23px;height:1px;background:var(--ink);margin:6px}
.hero{min-height:min(690px,78vw);height:calc(100svh - 82px);max-height:800px;position:relative;display:flex;align-items:center;overflow:hidden;background:#29251f;color:white}
.hero-image,.hero-shade{position:absolute;inset:0}
.hero-image{background-image:url('https://images.unsplash.com/photo-1614252369475-531eba835eb1?auto=format&fit=crop&w=2200&q=90');background-position:center 58%;background-size:cover;transform:scale(1.015)}
.hero-shade{background:linear-gradient(90deg,rgba(14,13,12,.82) 0%,rgba(14,13,12,.54) 43%,rgba(14,13,12,.05) 100%),linear-gradient(0deg,rgba(14,13,12,.2),transparent 45%)}
.hero-content{position:relative;z-index:1;width:min(680px,78%);margin-left:clamp(24px,10vw,150px);padding:70px 0}
.eyebrow{font-size:10px;line-height:1.5;font-weight:700;letter-spacing:.2em;color:var(--brown);margin:0 0 22px}
.eyebrow.light{color:#d2b98f}
.hero h1{font-family:var(--serif);font-size:clamp(54px,8.3vw,112px);line-height:.98;letter-spacing:-.045em;font-weight:500;margin:0 0 24px}
h1 em,h2 em{font-weight:500}
.hero-copy{max-width:380px;color:#e0ddd7;font-size:14px;line-height:1.9;margin:0}
.hero-actions{display:flex;align-items:center;gap:28px;margin-top:34px;flex-wrap:wrap}
.button{display:inline-flex;align-items:center;justify-content:center;gap:24px;min-height:50px;padding:0 21px;font-size:11px;font-weight:600;letter-spacing:.035em;border:1px solid transparent;transition:background .2s,color .2s,border-color .2s}
.button-light{background:var(--ivory);color:var(--ink)}
.button-light:hover{background:white}
.text-link{font-size:11px;font-weight:600;letter-spacing:.025em;display:inline-flex;align-items:center;gap:12px}
.light-link{color:#fff}
.hero-index{position:absolute;right:clamp(20px,6vw,88px);bottom:34px;display:flex;align-items:center;gap:12px;font-size:9px;letter-spacing:.17em;color:#e5e0d6}
.hero-index span:first-child{color:#d2b98f}
.index-line{width:42px;height:1px;background:#d2b98f}
.section-wrap{padding:clamp(72px,10vw,140px) clamp(22px,9vw,132px)}
.intro{background:var(--ivory)}
.intro-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(28px,8vw,110px);align-items:end}
h2{font-family:var(--serif);font-size:clamp(36px,5.2vw,66px);line-height:1.1;letter-spacing:-.035em;font-weight:500;margin:0}
.intro-grid>p,.craft-content>p:not(.eyebrow){font-size:13px;line-height:2;color:#69645b;margin:0;max-width:420px}
.collection{background:var(--paper)}
.section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:44px}
.section-heading .eyebrow{margin-bottom:14px}
.section-heading h2{font-size:clamp(38px,5vw,60px)}
.section-heading>.text-link{padding-bottom:9px;white-space:nowrap}
.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(14px,2.4vw,34px)}
.product-image{display:block;position:relative;aspect-ratio:4/5;background:#e6e0d6;overflow:hidden}
.product-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.65,.3,1)}
.product-card:hover .product-image img{transform:scale(1.04)}
.product-arrow{position:absolute;right:14px;bottom:14px;width:37px;height:37px;background:var(--paper);border-radius:50%;display:grid;place-items:center;font-size:17px;transition:background .2s,color .2s}
.product-card:hover .product-arrow{background:var(--ink);color:white}
.product-meta{display:flex;justify-content:space-between;gap:10px;margin-top:19px;font-size:8px;letter-spacing:.12em;color:#827b70}
.product-meta span:last-child{text-align:right;letter-spacing:.02em}
.product-card h3{font-family:var(--serif);font-size:25px;font-weight:500;margin:11px 0 7px}
.product-card>p{font-size:11px;line-height:1.8;color:var(--muted);margin:0;max-width:270px}
.catalog-note{margin:35px 0 0;font-size:10px;line-height:1.8;color:var(--muted)}
.craft{display:grid;grid-template-columns:1fr 1fr;background:var(--ink);color:white;min-height:550px}
.craft-image{background-image:url('https://images.unsplash.com/photo-1520639888713-7851133b1ed0?auto=format&fit=crop&w=1300&q=85');background-size:cover;background-position:center;min-height:440px}
.craft-content{padding:clamp(50px,8vw,112px) clamp(28px,8vw,110px);align-self:center}
.craft-content h2{font-size:clamp(42px,5.2vw,67px);margin-bottom:26px}
.craft-content>p:not(.eyebrow){color:#c4bfb6;margin:0 0 16px;max-width:410px}
.button-outline-light{border-color:#777064;color:white;margin-top:20px}
.button-outline-light:hover{background:var(--ivory);color:var(--ink)}
.contact{text-align:center;background:var(--ivory);display:flex;flex-direction:column;align-items:center}
.contact .eyebrow{margin-bottom:18px}
.contact h2{font-size:clamp(43px,6vw,72px)}
.contact-copy{font-size:12px;line-height:1.9;color:#6e685f;max-width:410px;margin:22px auto 27px}
.button-dark{background:var(--ink);color:white;min-width:205px}
.button-dark:hover{background:var(--brown)}
.wa-icon{width:18px;height:18px;fill:currentColor}
.contact-number{font-size:11px;letter-spacing:.12em;color:#655e53;margin:16px 0 0}
.site-footer{padding:37px clamp(22px,6vw,88px) 22px;background:#171714;color:#f4f0e8}
.footer-brand{display:inline-flex;align-items:center;gap:10px;font-size:11px;letter-spacing:.17em;font-weight:700}
.footer-brand img{width:34px;height:34px;object-fit:contain;background:white}
.site-footer>p{font-family:var(--serif);font-style:italic;font-size:17px;color:#c6b79c;margin:14px 0 30px}
.footer-bottom{border-top:1px solid #3c3933;padding-top:18px;display:flex;justify-content:space-between;gap:20px;font-size:9px;letter-spacing:.03em;color:#b9b4ab}
.footer-bottom a:hover{color:white}
.floating-wa{position:fixed;right:20px;bottom:20px;z-index:15;width:54px;height:54px;background:#218c54;color:white;border-radius:50%;display:grid;place-items:center;box-shadow:0 7px 24px #0003;transition:transform .2s}
.floating-wa:hover{transform:translateY(-3px)}
.floating-wa svg{width:26px;height:26px;fill:currentColor}
@media(min-width:1500px){.hero-content{margin-left:max(150px,calc((100vw - 1200px)/2))}}
@media(max-width:760px){
 .site-header{height:70px;padding:0 20px}.brand-mark{width:36px;height:36px}.brand-name{font-size:11px;letter-spacing:.14em}.brand-name span{font-size:9px;letter-spacing:.1em}
 .menu-toggle{display:block;cursor:pointer}
 .main-nav{display:none;position:absolute;top:70px;left:0;right:0;padding:18px 22px 24px;background:var(--paper);border-bottom:1px solid var(--line);align-items:stretch;gap:0;box-shadow:0 14px 20px #0000000b}
 .main-nav.is-open{display:flex;flex-direction:column}
 .main-nav>a{padding:14px 0;border-bottom:1px solid #e9e4dc}
 .main-nav .nav-cta{margin-top:14px;padding:14px;border:1px solid var(--ink);text-align:center}
 .hero{height:calc(88svh - 70px);min-height:570px;max-height:760px}
 .hero-image{background-position:58% center}
 .hero-shade{background:linear-gradient(90deg,rgba(14,13,12,.77),rgba(14,13,12,.3)),linear-gradient(0deg,rgba(14,13,12,.25),transparent 60%)}
 .hero-content{width:auto;margin:0 25px;padding:45px 0}
 .hero h1{font-size:clamp(57px,14vw,88px)}
 .hero-copy{font-size:13px;max-width:300px}
 .hero-index{bottom:23px;font-size:8px}
 .section-wrap{padding:76px 22px}
 .intro-grid{grid-template-columns:1fr;gap:23px}
 .intro-grid>p{max-width:440px}
 .section-heading{align-items:flex-start;flex-direction:column;margin-bottom:29px}
 .section-heading>.text-link{padding-bottom:0}
 .product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:27px 13px}
 .product-card:last-child{grid-column:1/-1;max-width:calc(50% - 7px)}
 .product-meta{flex-direction:column;gap:5px;margin-top:13px}
 .product-meta span:last-child{text-align:left}
 .product-card h3{font-size:22px}
 .product-card>p{font-size:10px}
 .craft{grid-template-columns:1fr}
 .craft-image{min-height:300px}
 .craft-content{padding:62px 25px 70px}
 .contact{padding-top:76px;padding-bottom:78px}
 .footer-bottom{flex-direction:column;gap:12px}
 .floating-wa{width:50px;height:50px;right:15px;bottom:15px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
